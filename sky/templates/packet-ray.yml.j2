# Packet.ai cluster config, rendered by sky.backends.cloud_vm_ray_backend.
#
# Mirrors quantacloud-ray.yml.j2 -- the closest in-tree analogue, a
# single-node rented-GPU box with no VPC/subnet/security-group to bootstrap
# -- and differs in exactly these ways, each MEASURED (ENG-562, 2026-10-15):
#
#   * ssh_user is `ubuntu`: MEASURED on the live box over password AND key
#     auth (sudo passwordless) — the schema example and reality agree this
#     time, but the provisioner still reads the live connection endpoint's
#     reported username first (see sky/provision/packet/instance.py
#     get_cluster_info); this literal only drives the initial ray bootstrap
#     SSH.
#   * node_config carries InstanceType = the "<accelerator>:<count>"
#     catalog token (e.g. rtxpro6000:1). The pool/product/region ids behind
#     it are EPHEMERAL (the launch-options surface flipped its product list
#     mid-session on 2026-10-15) -- the provisioner re-resolves the concrete
#     in-stock product/pool/numeric-region from the live list at launch,
#     or ADOPTS a console-launched box by the cluster NAME while creation
#     is 501 NOT_IMPLEMENTED for API keys (the ENG-562 ruling). There is no
#     OS variable: every launch boots the stock image (Ubuntu + NVIDIA
#     drivers + Docker; measured CUDA 13.0, driver 580.126.09).
#
# The public key is NOT threaded here as a value: `configure_ssh_info`
# substitutes the literal below, and the provisioner refuses the literal
# unsubstituted (see sky/provision/packet/instance.py).
cluster_name: {{cluster_name_on_cloud}}

# The maximum number of workers nodes to launch in addition to the head node.
max_workers: {{num_nodes - 1}}
upscaling_speed: {{num_nodes - 1}}
idle_timeout_minutes: 60

provider:
  type: external
  module: sky.provision.packet
  region: "{{region}}"
  disable_launch_config_check: true

auth:
  ssh_user: ubuntu
  ssh_private_key: {{ssh_private_key}}

available_node_types:
  ray_head_default:
{%- if custom_resources %}
    resources: {{custom_resources}}
{%- else %}
    resources: {}
{%- endif %}
    node_config:
      InstanceType: {{instance_type}}
      PublicKey: |-
        skypilot:ssh_public_key_content

head_node_type: ray_head_default

# Format: `REMOTE_PATH : LOCAL_PATH`
file_mounts: {
  "{{sky_ray_yaml_remote_path}}": "{{sky_ray_yaml_local_path}}",
  "{{sky_remote_path}}/{{sky_wheel_hash}}": "{{sky_local_path}}",
{%- for remote_path, local_path in credentials.items() %}
  "{{remote_path}}": "{{local_path}}",
{%- endfor %}
}

rsync_exclude: []

initialization_commands: []

# List of shell commands to run to set up nodes.
# NOTE: these are very performance-sensitive. Each new item opens/closes an SSH
# connection, which is expensive. Try your best to co-locate commands into fewer
# items!
#
# Increment the following for catching performance bugs easier:
#   current num items (num SSH connections): 1
setup_commands:
  # Create ~/.ssh/config file in case the file does not exist in the image.
  # Line 'rm ..': there is another installation of pip.
  # Line 'sudo bash ..': set the ulimit as suggested by ray docs for performance. https://ray.io/en/latest/cluster/vms/user-guides/large-cluster-best-practices.html#system-configuration
  # Line 'sudo grep ..': set the number of threads per process to unlimited to avoid ray job submit stucking issue when the number of running ray jobs increase.
  # Line 'mkdir -p ..': disable host key check
  # Line 'python3 -c ..': patch the buggy ray files and enable `-o allow_other` option for `goofys`
  - {%- for initial_setup_command in initial_setup_commands %}
    {{ initial_setup_command }}
    {%- endfor %}
    mkdir -p ~/.ssh; touch ~/.ssh/config; which patch > /dev/null || sudo apt install -y patch;
    {{ conda_installation_commands }}
    {{ uv_installation_commands }}
    {{ ray_skypilot_installation_commands }}
    {{ copy_skypilot_templates_commands }}
    sudo bash -c 'rm -rf /etc/security/limits.d; echo "* soft nofile 1048576" >> /etc/security/limits.conf; echo "* hard nofile 1048576" >> /etc/security/limits.conf';
    sudo grep -e '^DefaultTasksMax' /etc/systemd/system.conf || (sudo bash -c 'echo "DefaultTasksMax=infinity" >> /etc/systemd/system.conf'); sudo systemctl set-property user-$(id -u $(whoami)).slice TasksMax=infinity; sudo systemctl daemon-reload;
    (grep -Pzo -q "Host \*\n  StrictHostKeyChecking no" ~/.ssh/config) || printf "Host *\n  StrictHostKeyChecking no\n" >> ~/.ssh/config;
    {{ ssh_max_sessions_config }}

# Command to start ray clusters are now placed in `sky.provision.instance_setup`.
# We do not need to list it here anymore.
